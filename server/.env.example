# ---------------------------------------------------------------------------
# AI provider selection
# ---------------------------------------------------------------------------
# One of: openai | gemini | anthropic | openai-compatible
AI_PROVIDER=openai

# Optional global model override. Leave blank to use each provider's default
# (openai: gpt-4o-mini, gemini: gemini-2.0-flash, anthropic: claude-opus-5).
# Required when AI_PROVIDER=openai-compatible.
AI_MODEL=

# ---------------------------------------------------------------------------
# Provider credentials - these stay on the server and are never sent to the
# browser extension.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Any OpenAI-compatible endpoint (self-hosted or third party).
AI_BASE_URL=
AI_API_KEY=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info

# Optional shared secret. When set, the extension must send it as x-api-key.
API_ACCESS_KEY=

# Comma-separated. A single trailing * is supported, which is how the
# extension is allowed without pinning its (development-unstable) id.
CORS_ALLOWED_ORIGINS=chrome-extension://*,http://localhost:5173

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

PROVIDER_TIMEOUT_MS=45000
MAX_REQUEST_BODY=32kb

CACHE_ENABLED=true
CACHE_TTL_MS=1800000
CACHE_MAX_ENTRIES=500

# ---------------------------------------------------------------------------
# Optional persistence (not used yet - the architecture is prepared for it)
# ---------------------------------------------------------------------------
MONGODB_URI=
