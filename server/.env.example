# ---------------------------------------------------------------------------
# AI provider selection
# ---------------------------------------------------------------------------
# One of: openai | gemini | anthropic | openai-compatible
AI_PROVIDER=openai

# Optional model override for AI_PROVIDER. Leave blank to use each provider's
# default (openai: gpt-4o-mini, gemini: gemini-3.5-flash, anthropic: claude-opus-5).
# It applies to AI_PROVIDER only, so picking another provider in the extension
# never sends this model name to the wrong vendor.
# Required when AI_PROVIDER=openai-compatible.
AI_MODEL=

# ---------------------------------------------------------------------------
# Provider credentials - these stay on the server and are never sent to the
# browser extension. Users may instead enter their own key in the extension.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
# How long Gemini reasons before answering: minimal | low (default) | medium | high.
# Higher levels take far longer per question and can outlast the extension's
# request timeout. For quiz-style questions, AI_MODEL=gemini-3.5-flash-lite
# answered in ~1.5s against 5-28s for gemini-3.5-flash when measured.
GEMINI_THINKING_LEVEL=
ANTHROPIC_API_KEY=

# Any OpenAI-compatible endpoint (self-hosted or third party).
AI_BASE_URL=
AI_API_KEY=

# Let users bring their own provider key from the extension's settings
# (Settings -> AI provider). Such a key is sent per request in the
# x-ai-api-key header, used for that request only, and never stored or logged.
# Set to false to only ever use the keys above. Default: true.
ALLOW_CLIENT_AI_KEYS=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Set to production on a hosted server; that changes the defaults marked below.
NODE_ENV=development
# Most hosts (Render, Railway, Fly, Heroku-style) inject PORT themselves.
PORT=3000
# Blank: 127.0.0.1 in development, 0.0.0.0 in production.
HOST=
LOG_LEVEL=info

# Shared secret the extension sends as x-api-key. Optional in development,
# REQUIRED in production - the server refuses to start without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_ACCESS_KEY=

# Comma-separated. A single trailing * is supported, which is how the
# extension is allowed without pinning its (development-unstable) id.
# Blank: chrome-extension://*,http://localhost:5173 in development and
# chrome-extension://* in production. Once the extension has a fixed id
# (published, or a "key" in the manifest), pin it: chrome-extension://<id>
CORS_ALLOWED_ORIGINS=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Time allowed per question, retries included. Keep it under the extension's
# request timeout (30s by default) so the backend always answers first.
PROVIDER_TIMEOUT_MS=45000
# Time allowed per provider call. Past it the call counts as stalled and is
# retried while PROVIDER_TIMEOUT_MS lasts. Gemini's free tier leaves some calls
# hanging under a burst; 8000 with PROVIDER_TIMEOUT_MS=25000 recovers them.
# Blank: one call may use the whole budget and is not retried.
PROVIDER_ATTEMPT_TIMEOUT_MS=
MAX_REQUEST_BODY=32kb

CACHE_ENABLED=true
CACHE_TTL_MS=1800000
CACHE_MAX_ENTRIES=500

# ---------------------------------------------------------------------------
# Optional persistence - MongoDB or MongoDB Atlas
# ---------------------------------------------------------------------------
# Unset: answers are cached in memory (lost on restart) and no history is kept.
# Set: the answer cache and question history live in MongoDB, shared by every
# instance and kept across restarts and redeploys. A URI that is set but
# unreachable stops the server at startup.
#   Local / compose:  mongodb://localhost:27017/quiz-shop
#   Atlas:            mongodb+srv://<user>:<password>@<cluster>.mongodb.net/quiz-shop?retryWrites=true&w=majority
MONGODB_URI=
# Overrides the database named in the URI path (default: quiz-shop).
MONGODB_DB=
# Only if startup fails with "querySrv ECONNREFUSED": some VPNs and endpoint
# agents refuse the SRV lookups mongodb+srv:// needs. e.g. 8.8.8.8,1.1.1.1
MONGODB_DNS_SERVERS=

# Record each answered question (question, options, answer, and the page's
# origin - never page context, full URL or title). Needs MONGODB_URI.
HISTORY_ENABLED=true
# Entries older than this are deleted automatically by a TTL index.
HISTORY_RETENTION_DAYS=90
